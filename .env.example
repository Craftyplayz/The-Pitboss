DISCORD_TOKEN=your-bot-token-here
# right-click your server > Copy Server ID (needs Developer Mode)
GUILD_ID=
# optional: raises deadlock-api.com rate limits
DEADLOCK_API_KEY=
# the website's public address; recaps link here
SITE_URL=https://pitboss.craftyplayz.com
# password for /admin (the API call log viewer); leave empty to turn the page off
ADMIN_PASSWORD=
# control panel login (Developer Portal > your app > OAuth2); add <DASH_URL>/callback as a redirect there
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASH_URL=https://pitstop.craftyplayz.com
# second password for the control panel's Voice tab; leave empty to keep it locked
VOICE_PASSWORD=
